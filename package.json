{
  "name": "browser-computation-benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:wasm": "pnpm build:wasm && node scripts/inspect-wasm.mjs && node --experimental-strip-types --test tests/wasm.integration.ts",
    "build": "pnpm build:wasm && tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
